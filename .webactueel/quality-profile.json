{
  "schema_version": "1.0",
  "controller": "webactueel-workflow",
  "repository": "Yolol100/Designchecker",
  "repo_class": "core",
  "role": "shared-browser-and-visual-evidence",
  "owner_skill": "design",
  "profile_scope": "generic_capability",
  "project_truth": {
    "authority": "Project Design live manifest",
    "must_not_be_stored_in_repo": true
  },
  "master_rule_ids": [
    "repo.profile.contract",
    "repo.role.boundary",
    "repo.hygiene",
    "repo.tests",
    "repo.provenance",
    "repo.dependencies"
  ],
  "capability_evidence": [
    "browser-runtime",
    "axe-signals",
    "lighthouse-lab",
    "visual-diff",
    "markup-validation"
  ],
  "validation": {
    "commands": [
      "npm ci --ignore-scripts --no-audit --no-fund",
      "npm run check",
      "npm run build",
      "npm test",
      "npm run smoke"
    ],
    "workflow_gates": []
  },
  "evidence_contract": {
    "commit_sha": true,
    "result_readback": true,
    "artifact_or_result_identity": true,
    "owner_acceptance": true
  },
  "closure_contract": {
    "repo_success_is_not_workflow_complete": true,
    "temporary_target_evidence_off_default_branch": true,
    "project_truth_off_default_branch": true
  }
}
