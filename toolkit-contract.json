{
  "schema_version": "1.1",
  "owner_skill": "design",
  "consumer_skills": ["design", "website-qa-checklist"],
  "project_id": "project-design",
  "repository": "Yolol100/Designchecker",
  "evidence_role": "controlled_runtime_design_and_qa_evidence",
  "requires_account": false,
  "requires_api_key": false,
  "requires_mcp": false,
  "tools": [
    {"id":"playwright","version":"package-lock","trigger_when":"rendered design evidence or baseline is needed","outputs":["results/"]},
    {"id":"axe-core","version":"package-lock","trigger_when":"Design-owned accessibility risk signals are needed","outputs":["results/"]},
    {"id":"lighthouse","version":"package-lock","trigger_when":"performance signals materially affect a Design or Website QA decision","outputs":["results/"]},
    {"id":"pixelmatch","version":"package-lock","trigger_when":"before/after visual diff is requested","outputs":["results/"]},
    {"id":"sharp","version":"package-lock","trigger_when":"image evidence normalization is needed","outputs":["results/"]},
    {"id":"vnu-jar","version":"package-lock","trigger_when":"markup validity is relevant to controlled evidence","outputs":["results/"]},
    {"id":"owasp-zap-baseline","version":"2.17.0","trigger_when":"Website QA requests passive security signals for a verified public URL","outputs":["results/evidence/<request_id>/zap-report.json","results/evidence/<request_id>/zap-report.md","results/evidence/<request_id>/zap-report.html"]},
    {"id":"testssl.sh","version":"3.2.4@97763a411c525720a5f9bd9d2cded416b10f210a","trigger_when":"Website QA requests TLS configuration evidence for a verified HTTPS URL","outputs":["results/evidence/<request_id>/testssl-report.json","results/evidence/<request_id>/testssl-report.log"]}
  ],
  "usage_assertions": [
    {"tool":"playwright","path":"package.json","contains":"playwright"},
    {"tool":"axe-core","path":"package.json","contains":"axe-core"},
    {"tool":"lighthouse","path":"package.json","contains":"lighthouse"},
    {"tool":"pixelmatch","path":"package.json","contains":"pixelmatch"},
    {"tool":"sharp","path":"package.json","contains":"sharp"},
    {"tool":"vnu-jar","path":"package.json","contains":"vnu-jar"},
    {"tool":"owasp-zap-baseline","path":"src/tools/security.ts","contains":"ghcr.io/zaproxy/zaproxy:2.17.0"},
    {"tool":"testssl.sh","path":".github/workflows/command.yml","contains":"97763a411c525720a5f9bd9d2cded416b10f210a"}
  ],
  "boundaries": [
    "Direct routing remains allowlisted: Design routes plus Website QA qa-zap-baseline and qa-tls only.",
    "Website QA security tools are read-only evidence layers; they do not prove that a target is secure, compliant or vulnerability-free.",
    "Private/local targets remain blocked unless an intentionally controlled local test explicitly opts in.",
    "MCP packages may exist as optional adapters but are never required for the direct GitHub route.",
    "Automated accessibility signals are not a WCAG conformance claim."
  ]
}
