    {"id":"canva","owner":"design","purpose":"explicit Canva destination","auth_expected":true},
    {"id":"github","owner":"inherit","purpose":"direct command runtime, repository context and workflows","auth_expected":true},
    {"id":"google-drive","owner":"inherit","purpose":"canonical project truth and live source verification","auth_expected":true},
    {"id":"ahrefs","owner":"seo","purpose":"SEO market/ranking/link metrics when available","auth_expected":true},
    {"id":"product-design","owner":"design","purpose":"Work/Codex prototype and audit routes","auth_expected":false}
  ],
  "custom_mcp": {
    "id":"webactueel-evidence",
