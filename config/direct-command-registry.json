{
  "schema_version": "1.3",
  "runtime": "chatgpt-web-github-direct",
  "runtime_capability": "designchecker-direct",
  "transport": "ChatGPT GitHub app writes requests/command.json; GitHub Actions executes and commits results/<request_id>.json",
  "decision_order": ["goal","domain_owner","live_project_manifest","task_source_selectors","evidence_need","direct_command","result_to_owner"],
  "additional_account_required": false,
  "api_key_required": false,
  "mcp_required": false,
  "source_integrity_required": true,
  "routes": [
    {"command":"design","owner":"design","project_id":"project-design","tool":"design_inspect_page","capability":"design-inspection","executor":{"kind":"cli","name":"design"},"target_type":"public_url","preconditions":["verified_live_source","selected_source_selector"],"source_selectors":["ia-navigation","conversion-forms","ecommerce-checkout","system-accessibility","quality-audit","handoff","design-engineering","evidence-baseline"],"trigger_when":"Design owns the task and rendered-page evidence can materially change the design decision, risk or acceptance.","do_not_trigger_when":"Pure strategy/briefing without runtime evidence, explicit Figma/Canva/Product Design/ImageGen output, implementation-only work or independent QA-only acceptance.","why":"Collect bounded rendered-page evidence for the Design owner without transferring design ownership."},
    {"command":"design-baseline","owner":"design","project_id":"project-design","tool":"design_capture_baseline","capability":"browser-baseline","executor":{"kind":"cli","name":"baseline"},"target_type":"public_url","preconditions":["verified_live_source","selected_source_selector"],"source_selectors":["quality-audit","handoff","design-engineering","evidence-baseline","claims-scoring"],"trigger_when":"Before redesign, cleanup, before/after comparison, design-engineering handoff or a claim that requires a reproducible visual baseline.","do_not_trigger_when":"No mutation/comparison/claim is planned or a current valid baseline already covers the exact artifact, version, route, state and viewport scope.","why":"Create reproducible desktop/tablet/mobile controlled-runtime screenshots before change."},
    {"command":"design-diff","owner":"design","project_id":"project-design","tool":"design_compare_screenshots","capability":"visual-diff","executor":{"kind":"cli","name":"diff"},"target_type":"repo_input_pair","preconditions":["verified_live_source","selected_source_selector","input_under_requests_inputs"],"source_selectors":["quality-audit","evidence-baseline","claims-scoring"],"trigger_when":"A before/after or regression comparison is required and two same-dimension screenshots are available.","do_not_trigger_when":"There is no comparable baseline, dimensions differ by design, or visual change alone cannot answer the user question.","why":"Quantify candidate visual change; Design still decides whether the change is intended or better."},
    {"command":"seo","owner":"seo","project_id":"project-seo","tool":"seo_inspect_page","capability":"seo-inspection","executor":{"kind":"cli","name":"seo"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"seo-technical","owner":"seo","project_id":"project-seo","tool":"seo_technical_audit","capability":"seo-technical-evidence","executor":{"kind":"python","path":"scripts/seo-technical.py"},"target_type":"public_url","preconditions":["verified_live_source"],"scope_note":"Bounded current-page technical readiness evidence. This does not claim full parity with the legacy seochecker crawl/Lighthouse/validator stack."},
    {"command":"elementor","owner":"elementor","project_id":"project-elementor","tool":"elementor_inspect_page","capability":"elementor-inspection","executor":{"kind":"cli","name":"elementor"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"elementor-json","owner":"elementor","project_id":"project-elementor","tool":"elementor_json_audit","capability":"elementor-json-audit","executor":{"kind":"node","path":"scripts/elementor-json.mjs"},"target_type":"repo_input_file","preconditions":["verified_live_source","input_under_requests_inputs"]},
    {"command":"leads","owner":"leads","project_id":"project-leads","tool":"lead_inspect_public_site","capability":"public-site-inspection","executor":{"kind":"cli","name":"leads"},"target_type":"public_url","preconditions":["verified_live_source","lead_registry_preflight_verified"],"evidence_scope":"support-only-public-signals-not-formal-qualification"},
    {"command":"lead-formal","owner":"leads","project_id":"project-leads","tool":"lead_formal_site_scan","capability":"lead-formal-browser-evidence","executor":{"kind":"node","path":"scripts/lead-formal.mjs"},"target_type":"public_url","preconditions":["verified_live_source","lead_registry_preflight_verified","lead_id","site_type","scan_policy_version"],"status":"blocked-contract","blocked_reason":"Project Leads 10.5.0 requires webactueel-leadscanner-ingest/1.0 provenance plus artifact readback. The current Designchecker lead-formal output does not meet that exact formal ingestion contract."},
    {"command":"qa","owner":"website-qa-checklist","project_id":"project-checklist","tool":"qa_collect_page_evidence","capability":"qa-evidence-bundle","executor":{"kind":"cli","name":"qa"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"a11y","owner":"design","project_id":"project-design","tool":"design_accessibility_risks","capability":"accessibility-signals","executor":{"kind":"cli","name":"a11y"},"target_type":"public_url","preconditions":["verified_live_source","selected_source_selector"],"source_selectors":["system-accessibility","quality-audit"],"trigger_when":"Design owns an accessibility-sensitive component/page decision and automated risk signals can change the design decision or acceptance criteria.","do_not_trigger_when":"The request is a formal WCAG conformance claim or independent browser/AT acceptance; route that acceptance to Website QA.","why":"Find automated accessibility risks as controlled-runtime support evidence, never as a conformance claim."},
    {"command":"a11y","owner":"website-qa-checklist","project_id":"project-checklist","tool":"qa_accessibility_risks","capability":"accessibility-signals","executor":{"kind":"cli","name":"a11y"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"links","owner":"seo","project_id":"project-seo","tool":"seo_check_links","capability":"link-check","executor":{"kind":"cli","name":"links"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"links","owner":"website-qa-checklist","project_id":"project-checklist","tool":"qa_check_links","capability":"link-check","executor":{"kind":"cli","name":"links"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"performance","owner":"seo","project_id":"project-seo","tool":"seo_performance_lab","capability":"performance-signals","executor":{"kind":"cli","name":"performance"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"performance","owner":"wordpressqualityarchitect","project_id":"project-plugin","tool":"wordpress_performance_lab","capability":"performance-signals","executor":{"kind":"cli","name":"performance"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"performance","owner":"website-qa-checklist","project_id":"project-checklist","tool":"qa_performance_lab","capability":"performance-signals","executor":{"kind":"cli","name":"performance"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"html","owner":"seo","project_id":"project-seo","tool":"seo_validate_html","capability":"html-validation","executor":{"kind":"cli","name":"html"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"html","owner":"wordpressqualityarchitect","project_id":"project-plugin","tool":"wordpress_validate_html","capability":"html-validation","executor":{"kind":"cli","name":"html"},"target_type":"public_url","preconditions":["verified_live_source"]},
    {"command":"html","owner":"website-qa-checklist","project_id":"project-checklist","tool":"qa_validate_html","capability":"html-validation","executor":{"kind":"cli","name":"html"},"target_type":"public_url","preconditions":["verified_live_source"]}
  ]
}
